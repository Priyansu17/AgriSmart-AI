# Virtual Environment
venv/
env/
ENV/
.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Node & Frontend dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.vite/

# Frontend Dist (Wait, should we track frontend/dist for Render? YES! If frontend/dist is tracked, Render doesn't need to install node or run npm run build; Flask serves frontend/dist right out of the box!)

# Environment variables & secrets
.env
.env.local
.env.*.local

# Executables & Cloudflare binaries
cloudflared.exe
*.exe

# Logs & temp files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS settings
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
